<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= event.couple_names %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Beau+Rivage&family=Cormorant+Garamond:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/themes/<%= event.theme %>/theme.css">
</head>
<body class="d1-page">
  <div class="d1-landing-grid">
    <div class="d1-landing-left">
      <img class="d1-floral" src="/themes/<%= event.theme %>/img/floral-illustration.png" alt="">
      <p class="d1-label d1-date"><%= formatEventDate(event.wedding_date) %></p>
      <h1 class="d1-script d1-names"><%= event.couple_names %></h1>
      <button type="button" class="d1-btn" id="open-overlay">Come on in</button>
    </div>
    <div class="d1-landing-right">
      <% if (event.card_image) { %>
        <img src="<%= event.card_image %>" alt="<%= event.couple_names %>">
      <% } else { %>
        <div class="d1-photo-placeholder"></div>
      <% } %>
    </div>
  </div>

  <div class="d1-overlay" id="passcode-overlay" hidden>
    <div class="d1-overlay-card">
      <button type="button" class="d1-overlay-close" id="close-overlay" aria-label="Close">&times;</button>
      <p class="d1-label d1-overlay-label">Enter your passcode</p>
      <% if (typeof error !== 'undefined' && error) { %>
        <p class="d1-error"><%= error %></p>
      <% } %>
      <form method="POST" action="/invite/<%= event.id %>/verify">
        <input type="text" name="passcode" placeholder="Passcode" required autocapitalize="characters" autocomplete="off">
        <button type="submit" class="d1-btn">View Invitation</button>
      </form>
    </div>
  </div>

  <script>
    var overlay = document.getElementById('passcode-overlay');
    document.getElementById('open-overlay').addEventListener('click', function () { overlay.hidden = false; });
    document.getElementById('close-overlay').addEventListener('click', function () { overlay.hidden = true; });
    <% if (typeof error !== 'undefined' && error) { %>
    overlay.hidden = false;
    <% } %>
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= event.couple_names %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Beau+Rivage&family=Cormorant+Garamond:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/themes/<%= event.theme %>/theme.css">
</head>
<body class="d1-page">
  <div class="d1-reveal">
    <% if (state === 'card' && welcomeBack) { %>
      <div class="d1-banner">
        <p><%= event.decline_message %></p>
        <p><strong>We will be delighted if your schedule has now allowed you to participate.</strong></p>
      </div>
    <% } %>

    <% if (event.card_image) { %>
      <img class="d1-card-img" src="<%= event.card_image %>" alt="<%= event.couple_names %>">
    <% } %>
    <h1 class="d1-script d1-names"><%= event.couple_names %></h1>
    <p class="d1-meta"><%= formatEventDate(event.wedding_date) %> — <%= event.venue %></p>

    <% if (state === 'card') { %>
      <p>Hi <%= guest.name %>, seats reserved: <%= guest.seat_count %></p>
      <div class="d1-actions">
        <form method="POST" action="/invite/<%= event.id %>/rsvp">
          <input type="hidden" name="passcode" value="<%= guest.passcode %>">
          <input type="hidden" name="response" value="accepted">
          <button type="submit" class="d1-btn"><%= event.accept_button_text %></button>
        </form>
        <% if (!welcomeBack) { %>
          <form method="POST" action="/invite/<%= event.id %>/rsvp">
            <input type="hidden" name="passcode" value="<%= guest.passcode %>">
            <input type="hidden" name="response" value="declined">
            <button type="submit" class="d1-btn"><%= event.decline_button_text %></button>
          </form>
        <% } %>
      </div>

    <% } else if (state === 'qr') { %>
      <p>Hi <%= guest.name %>, seats reserved: <%= guest.seat_count %></p>
      <p>You're on the list! Show this QR code at the door.</p>
      <% if (checkedIn) { %>
        <p><strong>You're already checked in.</strong> This still works if you need to show it again.</p>
      <% } %>
      <img class="d1-qr" src="<%= qrDataUrl %>" alt="Your gatepass QR code">

    <% } else if (state === 'expired') { %>
      <p>This invite is no longer active. Thanks for celebrating with us!</p>
    <% } %>

    <% if (state === 'card' || state === 'qr') { %>
      <a class="d1-itinerary-link" href="/invite/<%= event.id %>/itinerary">View the day's itinerary &rarr;</a>
    <% } %>
  </div>
</body>
</html>

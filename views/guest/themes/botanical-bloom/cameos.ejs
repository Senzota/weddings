<!DOCTYPE html>
<html lang="en" class="bb-page">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Cameos — <%= event.couple_names %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Beau+Rivage&family=Cormorant+Garamond:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/themes/<%= event.theme %>/theme.css">
</head>
<body class="bb-page">
  <section class="bb-section">
    <img class="bb-section-motif" src="/themes/<%= event.theme %>/img/floral-illustration.png" alt="">
    <h2 class="bb-script">Cameos</h2>

    <% if (photos === null) { %>
      <!-- Only reached for 'recognized'/'closed' events with no verified
           guest — 'open' events always pass a (possibly empty) array. -->
      <p>Enter your passcode to view the cameos.</p>
      <% if (error) { %>
        <p class="bb-error"><%= error %></p>
      <% } %>
      <form method="GET" action="/invite/<%= event.id %>/cameos">
        <input type="text" name="passcode" placeholder="Passcode" required autocapitalize="characters" autocomplete="off">
        <button type="submit" class="bb-btn">View Cameos</button>
      </form>

    <% } else if (photos.length === 0) { %>
      <p>Cameos will appear here soon.</p>

    <% } else { %>
      <div class="bb-gallery-grid">
        <% photos.forEach(function (photo) { %>
          <div class="bb-gallery-cell">
            <a href="<%= photo.image_url %>" target="_blank">
              <img src="<%= photo.image_url %>" alt="<%= photo.title || '' %>">
            </a>
            <a class="bb-gallery-download" href="<%= getDownloadUrl(photo.image_url) %>" download title="Download">&darr;</a>
            <% if (photo.title) { %><span class="bb-cameo-caption"><%= photo.title %></span><% } %>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>
  <p style="text-align:center;"><a class="bb-btn" href="/invite/<%= event.id %>">&larr; Back to the invitation</a></p>
</body>
</html>

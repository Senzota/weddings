<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>You're Invited</title>
</head>
<body>
  <% if (state === 'not_found') { %>
    <p>We couldn't find this wedding.</p>

  <% } else if (state === 'not_live') { %>
    <p>This invitation isn't available yet. Please check back soon.</p>

  <% } else if (state === 'passcode_form') { %>
    <% if (typeof event !== 'undefined' && event) { %>
      <h1><%= event.couple_names %></h1>
    <% } %>
    <p>Enter your passcode to view your invitation.</p>
    <% if (typeof error !== 'undefined' && error) { %>
      <p style="color: red;"><%= error %></p>
    <% } %>
    <form method="POST" action="/invite/<%= event.id %>/verify">
      <input type="text" name="passcode" placeholder="Your passcode" required autocapitalize="characters">
      <button type="submit">View Invitation</button>
    </form>

  <% } else if (state === 'card') { %>
    <div class="reveal">
      <% if (event.card_image) { %>
        <img src="<%= event.card_image %>" alt="Invitation card" style="max-width:400px">
      <% } %>
      <h1><%= event.couple_names %></h1>
      <p><%= event.wedding_date %> — <%= event.venue %></p>
      <p>Hi <%= guest.name %>, seats reserved: <%= guest.seat_count %></p>

      <form method="POST" action="/invite/<%= event.id %>/rsvp" style="display:inline">
        <input type="hidden" name="passcode" value="<%= guest.passcode %>">
        <input type="hidden" name="response" value="accepted">
        <button type="submit"><%= event.accept_button_text %></button>
      </form>
      <form method="POST" action="/invite/<%= event.id %>/rsvp" style="display:inline">
        <input type="hidden" name="passcode" value="<%= guest.passcode %>">
        <input type="hidden" name="response" value="declined">
        <button type="submit"><%= event.decline_button_text %></button>
      </form>
    </div>

  <% } else if (state === 'qr') { %>
    <h1><%= event.couple_names %></h1>
    <p>You're on the list, <%= guest.name %>! Show this QR code at the door.</p>
    <% if (checkedIn) { %>
      <p><strong>You're already checked in.</strong> This still works if you need to show it again.</p>
    <% } %>
    <img src="<%= qrDataUrl %>" alt="Your gatepass QR code" style="max-width:300px">

  <% } else if (state === 'expired') { %>
    <h1><%= event.couple_names %></h1>
    <p>This invite is no longer active. Thanks for celebrating with <%= event.couple_names %>!</p>

  <% } else if (state === 'declined') { %>
    <h1><%= event.couple_names %></h1>
    <p>You've already responded — you declined this invitation. Thank you for letting us know, <%= guest.name %>.</p>
  <% } %>
</body>
</html>

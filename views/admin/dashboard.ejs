<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= event.couple_names %> — Dashboard</title>
</head>
<body>
  <p><a href="/admin/events">&larr; All weddings</a></p>
  <h1><%= event.couple_names %></h1>

  <section>
    <h2>Shareable invite link</h2>
    <p>Share this one link everywhere (WhatsApp status, a group, etc.) — every guest uses it with their own passcode.</p>
    <input type="text" readonly value="<%= baseUrl %>/invite/<%= event.id %>" style="width: 320px;" onclick="this.select()">
    <button type="button" class="copy-btn" data-copy="<%= baseUrl %>/invite/<%= event.id %>">Copy Link</button>
  </section>

  <section>
    <h2>Door scanner</h2>
    <p>Works for any event — no login needed. Hand this link to door staff on the wedding day.</p>
    <a href="/scan">Open Door Scanner</a>
    <button type="button" class="copy-btn" data-copy="<%= baseUrl %>/scan">Copy Link</button>
  </section>

  <section>
    <h2>Status: <%= event.status %></h2>
    <form method="POST" action="/admin/events/<%= event.id %>/status">
      <button type="submit"><%= event.status === 'live' ? 'Switch to Draft' : 'Go Live' %></button>
    </form>
  </section>

  <section>
    <h2>Live stats</h2>
    <ul>
      <li>Total guests: <%= stats.total_guests %></li>
      <li>Accepted: <%= stats.accepted %></li>
      <li>Declined: <%= stats.declined %></li>
      <li>Seats accepted: <%= stats.seats_accepted %></li>
      <li>Checked in: <%= stats.checked_in %></li>
    </ul>
  </section>

  <section>
    <h2>Wedding details</h2>
    <% if (typeof error !== 'undefined' && error) { %>
      <p style="color: red;"><%= error %></p>
    <% } %>
    <form method="POST" action="/admin/events/<%= event.id %>" enctype="multipart/form-data">
      <label>Couple names <input type="text" name="coupleNames" value="<%= event.couple_names %>" required></label><br>
      <label>Wedding date <input type="date" name="weddingDate" value="<%= event.wedding_date %>" required></label><br>
      <label>Venue <input type="text" name="venue" value="<%= event.venue %>" required></label><br>
      <label>Theme color <input type="color" name="themeColor" value="<%= event.theme_color %>"></label><br>
      <label>Accept button text <input type="text" name="acceptButtonText" value="<%= event.accept_button_text %>"></label><br>
      <label>Decline button text <input type="text" name="declineButtonText" value="<%= event.decline_button_text %>"></label><br>
      <label>Decline message <textarea name="declineMessage" rows="3" cols="50"><%= event.decline_message %></textarea></label><br>
      <% if (event.card_image) { %>
        <p>Current card: <img src="<%= event.card_image %>" alt="Invitation card" style="max-width:200px"></p>
      <% } %>
      <label>Card image <input type="file" name="cardImage" accept="image/png,image/jpeg,image/webp"></label><br>
      <label>Itinerary <textarea name="itinerary" rows="6" cols="50" placeholder="One item per line, e.g.&#10;4:00 PM - Ceremony&#10;5:30 PM - Cocktail hour&#10;7:00 PM - Reception"><%= event.itinerary || '' %></textarea></label><br>
      <label>Invitation message <textarea name="invitationMessage" rows="4" cols="50" placeholder="A personal note from the couple to their guests."><%= event.invitation_message || '' %></textarea></label><br>
      <label>Contact details <textarea name="contactDetails" rows="3" cols="50" placeholder="How guests can reach the couple, e.g. phone/email."><%= event.contact_details || '' %></textarea></label><br>
      <button type="submit">Save</button>
    </form>
  </section>

  <section>
    <h2>Add guests</h2>
    <form method="POST" action="/admin/events/<%= event.id %>/guests">
      <p>One guest per line: <code>Name, seat count</code></p>
      <textarea name="guestList" rows="6" cols="40" placeholder="Jane Doe, 2&#10;John Smith, 1"></textarea><br>
      <button type="submit">Add Guests</button>
    </form>
  </section>

  <section>
    <h2>Guest list</h2>
    <p><a href="/admin/events/<%= event.id %>/export">Download Guest List (Excel)</a></p>
    <table border="1" cellpadding="4">
      <thead>
        <tr><th>Name</th><th>Seats</th><th>Passcode</th><th></th><th>RSVP</th><th>Checked in</th></tr>
      </thead>
      <tbody>
        <% guests.forEach(function(guest) { %>
          <tr>
            <td><%= guest.name %></td>
            <td><%= guest.seat_count %></td>
            <td><%= guest.passcode %></td>
            <td><button type="button" class="copy-btn" data-copy="<%= guest.passcode %>">Copy Code</button></td>
            <td><%= guest.rsvp_status %></td>
            <td><%= guest.checked_in ? 'Yes' : 'No' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>

  <section>
    <h2>Danger zone</h2>
    <form method="POST" action="/admin/events/<%= event.id %>/delete" onsubmit="return confirm('Delete this wedding permanently? Summary metrics will be kept, but all guest and gatepass data will be gone for good.');">
      <button type="submit">Delete Wedding</button>
    </form>
  </section>

  <script>
    document.querySelectorAll('.copy-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        navigator.clipboard.writeText(btn.dataset.copy).then(function () {
          var original = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(function () { btn.textContent = original; }, 1500);
        });
      });
    });
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Your account — Weddings 103</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --cd-ink: #2b2622;
      --cd-muted: #6b625a;
      --cd-accent: #a68a54;
      --cd-accent-deep: #8a6d3b;
      --cd-bg: #faf6ee;
      --cd-card-bg: #fffdf9;
      --cd-border: #e8dfd0;
      --cd-wash: #f4ecd9;
      --cd-radius: 16px;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: 'DM Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
      background: var(--cd-bg);
      color: var(--cd-ink);
      line-height: 1.6;
    }
    a { color: var(--cd-accent-deep); }
    :focus-visible {
      outline: 3px solid var(--cd-accent-deep);
      outline-offset: 3px;
    }
    button:focus-visible, a:focus-visible { border-radius: 4px; }

    .cd-wrap { max-width: 1080px; margin: 0 auto; padding: 40px 24px 72px; }

    .cd-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
      padding-bottom: 32px;
      margin-bottom: 40px;
      border-bottom: 1px solid var(--cd-border);
    }
    .cd-eyebrow {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--cd-accent-deep);
      margin: 0 0 10px;
    }
    .cd-header h1 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2.1rem;
      font-weight: 600;
      margin: 0 0 6px;
      color: var(--cd-ink);
    }
    .cd-header p {
      margin: 0;
      color: var(--cd-muted);
      font-size: 1rem;
    }
    .cd-signout-form { flex-shrink: 0; }
    .cd-signout-btn {
      background: transparent;
      border: 1px solid var(--cd-border);
      color: var(--cd-muted);
      padding: 0.55em 1.2em;
      border-radius: 999px;
      font-size: 0.85rem;
      font-family: inherit;
      cursor: pointer;
      transition: border-color 0.15s ease, color 0.15s ease;
    }
    .cd-signout-btn:hover { border-color: var(--cd-accent-deep); color: var(--cd-accent-deep); }
    @media (prefers-reduced-motion: reduce) {
      .cd-signout-btn { transition: none; }
    }

    /* State A / B shared card */
    .cd-status-card {
      background: var(--cd-card-bg);
      border: 1px solid var(--cd-border);
      border-radius: var(--cd-radius);
      padding: 2.25rem;
      box-shadow: 0 1px 3px rgba(43, 38, 34, 0.05);
      max-width: 620px;
    }
    .cd-status-card h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.6rem;
      font-weight: 600;
      margin: 0 0 0.6rem;
    }
    .cd-status-card p {
      margin: 0 0 1.25rem;
      color: var(--cd-muted);
    }
    .cd-status-card p:last-of-type { margin-bottom: 0; }
    .cd-cta-btn {
      display: inline-block;
      padding: 0.75em 1.75em;
      border: none;
      border-radius: 999px;
      background: var(--cd-accent-deep);
      color: #fff;
      font-size: 0.95rem;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
      font-family: inherit;
      transition: background 0.15s ease;
    }
    .cd-cta-btn:hover { background: #755a2e; }
    @media (prefers-reduced-motion: reduce) {
      .cd-cta-btn { transition: none; }
    }

    /* State C: My Events */
    .cd-section-head { margin-bottom: 1.75rem; }
    .cd-section-head h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.9rem;
      font-weight: 600;
      margin: 0 0 0.4rem;
    }
    .cd-section-head p { margin: 0; color: var(--cd-muted); }

    .cd-events-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
      margin-bottom: 2rem;
    }
    .cd-events-grid.cd-events-single { grid-template-columns: minmax(280px, 440px); }

    .cd-event-card {
      background: var(--cd-card-bg);
      border: 1px solid var(--cd-border);
      border-left: 4px solid var(--cd-accent);
      border-radius: var(--cd-radius);
      padding: 1.75rem;
      box-shadow: 0 1px 3px rgba(43, 38, 34, 0.05);
      display: flex;
      flex-direction: column;
    }
    .cd-event-eyebrow {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--cd-accent-deep);
      margin-bottom: 0.75rem;
    }
    .cd-status-pill {
      display: inline-block;
      padding: 0.2em 0.7em;
      border-radius: 999px;
      background: var(--cd-wash);
      color: var(--cd-accent-deep);
      font-size: 0.68rem;
      letter-spacing: 0.06em;
    }
    .cd-event-card h3 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.4rem;
      font-weight: 600;
      margin: 0 0 0.5rem;
    }
    .cd-event-meta {
      margin: 0 0 1.5rem;
      color: var(--cd-muted);
      font-size: 0.9rem;
    }
    .cd-event-meta span { display: block; margin-top: 2px; }
    .cd-open-btn {
      margin-top: auto;
      padding: 0.65em 1.5em;
      border: none;
      border-radius: 999px;
      background: var(--cd-accent-deep);
      color: #fff;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      font-family: inherit;
      align-self: flex-start;
      transition: background 0.15s ease;
    }
    .cd-open-btn:hover { background: #755a2e; }
    @media (prefers-reduced-motion: reduce) {
      .cd-open-btn { transition: none; }
    }

    .cd-secondary-notice {
      background: var(--cd-wash);
      border: 1px solid var(--cd-border);
      border-radius: var(--cd-radius);
      padding: 1.1rem 1.5rem;
      max-width: 480px;
      color: var(--cd-accent-deep);
      font-size: 0.9rem;
    }
    .cd-secondary-notice p { margin: 0; }

    .cd-foot { margin-top: 2.5rem; font-size: 0.9rem; }
    .cd-foot a { color: var(--cd-muted); }

    @media (max-width: 640px) {
      .cd-wrap { padding: 28px 18px 56px; }
      .cd-header { flex-direction: column; }
      .cd-status-card { padding: 1.5rem; }
    }
  </style>
</head>
<body>
  <div class="cd-wrap">
    <header class="cd-header">
      <div>
        <p class="cd-eyebrow">Weddings 103</p>
        <h1>Welcome back, <%= client.full_name %>.</h1>
        <p>Your celebrations, all in one place.</p>
      </div>
      <form method="POST" action="/client/logout" class="cd-signout-form">
        <button type="submit" class="cd-signout-btn">Sign out</button>
      </form>
    </header>

    <% if (myEvents.length > 0) { %>
      <section class="cd-section-head">
        <h2>My Events</h2>
        <p>Your approved celebrations are ready to manage.</p>
      </section>

      <div class="cd-events-grid <%= myEvents.length === 1 ? 'cd-events-single' : '' %>">
        <% myEvents.forEach(function (event) { %>
          <article class="cd-event-card">
            <div class="cd-event-eyebrow">
              <span><%= event.typeLabel %></span>
              <span class="cd-status-pill"><%= event.statusLabel %></span>
            </div>
            <h3><%= event.title %></h3>
            <p class="cd-event-meta">
              <span><%= event.dateLabel %></span>
              <span><%= event.themeLabel %></span>
            </p>
            <form method="post" action="/client/select-event">
              <input type="hidden" name="eventId" value="<%= event.id %>">
              <button type="submit" class="cd-open-btn">Open Event</button>
            </form>
          </article>
        <% }) %>
      </div>

      <% if (hasPendingInquiry) { %>
        <div class="cd-secondary-notice">
          <p>Another booking request is under review.</p>
        </div>
      <% } %>
    <% } else if (hasPendingInquiry) { %>
      <div class="cd-status-card">
        <h2>Your booking request is under review.</h2>
        <p>We have received your request and our team is reviewing the details. Your event workspace will appear here once your booking is approved.</p>
      </div>
    <% } else { %>
      <div class="cd-status-card">
        <h2>Ready to start planning your event?</h2>
        <p>Create your booking request to begin planning with us.</p>
        <a href="/client/book-event" class="cd-cta-btn">Book an Event</a>
      </div>
    <% } %>

    <p class="cd-foot"><a href="/">&larr; Back to homepage</a></p>
  </div>
</body>
</html>

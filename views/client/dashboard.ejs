<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Your account — Weddings 103</title>
  <style>
    :root { --ph-ink: #2b2622; --ph-muted: #6b625a; --ph-accent: #8a6d3b; --ph-bg: #faf8f5; --ph-border: #e6e0d8; }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; background: var(--ph-bg); color: var(--ph-ink); line-height: 1.55; }
    a { color: var(--ph-accent); }
    .ca-wrap { max-width: 520px; margin: 0 auto; padding: 48px 24px; }
    h1 { font-size: 1.6rem; margin: 0 0 0.5rem; }
    .ca-card { background: #fff; border: 1px solid var(--ph-border); border-radius: 12px; padding: 1.75rem; margin-top: 1.5rem; }
    .ca-btn {
      display: inline-block; padding: 0.6em 1.4em;
      border: none; border-radius: 999px; background: var(--ph-accent);
      color: #fff; font-size: 0.95rem; font-weight: 600; cursor: pointer;
    }
    .ca-btn:focus { outline: 2px solid var(--ph-ink); outline-offset: 2px; }
    .ca-foot { margin-top: 1.5rem; font-size: 0.9rem; color: var(--ph-muted); }
  </style>
</head>
<body>
  <div class="ca-wrap">
    <p>Signed in as <strong><%= client.full_name %></strong></p>
    <% if (hasOwnedEvent) { %>
      <h1>Our Wedding</h1>
      <div class="ca-card">
        <p>Your wedding workspace is ready.</p>
        <form method="post" action="/client/select-event">
          <button type="submit" class="ca-btn">Open Our Wedding</button>
        </form>
      </div>
    <% } else if (hasPendingInquiry) { %>
      <h1>Your booking request is under review.</h1>
      <div class="ca-card">
        <p>We'll let you know once it's been reviewed.</p>
      </div>
    <% } else { %>
      <h1>No active wedding yet.</h1>
      <div class="ca-card">
        <p>Nothing to show here yet.</p>
      </div>
    <% } %>
    <form method="POST" action="/client/logout" style="margin-top:1rem;">
      <button type="submit" class="ca-btn">Sign out</button>
    </form>
    <p class="ca-foot"><a href="/">&larr; Back to homepage</a></p>
  </div>
</body>
</html>
